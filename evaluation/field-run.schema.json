{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic diagram redraw field run",
  "type": "object",
  "required": [
    "task_id",
    "skill",
    "version",
    "diagram_class",
    "builder",
    "first_minutes",
    "total_minutes",
    "practical_state",
    "formal_state",
    "fixlist_count",
    "final_accepted"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "skill": {
      "enum": [
        "redraw-academic-diagrams",
        "redraw-academic-diagrams-fast"
      ]
    },
    "version": {"type": "string"},
    "diagram_class": {"type": "string"},
    "builder": {"type": "string"},
    "first_minutes": {"type": "number", "minimum": 0},
    "total_minutes": {"type": "number", "minimum": 0},
    "user_edit_minutes": {"type": "number", "minimum": 0},
    "ai_revision_minutes": {"type": "number", "minimum": 0},
    "feedback_rounds": {"type": "integer", "minimum": 0},
    "practical_state": {
      "enum": [
        "FAST PASS",
        "FAST PASS WITH FIXLIST",
        "FAST-NOT-ACCEPTABLE"
      ]
    },
    "formal_state": {"type": "string"},
    "fixlist_count": {"type": "integer", "minimum": 0},
    "final_accepted": {"type": "boolean"},
    "defects": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
